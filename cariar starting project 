<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>स्कैम रक्षक (Scam Rakshak)</title>
    <!-- सही और आधुनिक Tailwind CSS CDN -->
    <script src="https://jsdelivr.net"></script>
    <style>
        /* देवनागरी फॉन्ट को सही से लोड करने के लिए */
        @import url('https://googleapis.com');
        body { font-family: 'Noto Sans Devanagari', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-gray-800 flex items-center justify-center min-h-screen p-4">

    <div class="max-w-md w-full bg-white rounded-2xl shadow-2xl p-6 border border-gray-100">
        <!-- हेडर -->
        <h1 class="text-3xl font-bold text-center text-red-600 flex justify-center items-center gap-2 mb-1">
            🛡️ स्कैम रक्षक
        </h1>
        <p class="text-center text-xs text-gray-500 mb-6 font-medium">आपकी अच्छाई की ढाल - धोखाधड़ी से सुरक्षा</p>

        <!-- इनपुट बॉक्स -->
        <div class="mb-4">
            <label for="scamInput" class="block font-bold text-gray-700 mb-2">यहाँ संदेश, लिंक या जॉब ऑफर पेस्ट करें:</label>
            <textarea id="scamInput" rows="5" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:outline-none text-sm transition" placeholder="उदाहरण: टेलीग्राम पर वीडियो लाइक करके पैसे कमाएं, या इस लिंक पर क्लिक करें..."></textarea>
        </div>

        <!-- बटन -->
        <button onclick="checkScam()" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-xl transition duration-200 cursor-pointer shadow-md mb-4 active:scale-95">
            स्कैम की जाँच करें
        </button>

        <!-- परिणाम बॉक्स -->
        <div id="resultBox" class="hidden p-4 rounded-xl mb-4 font-medium text-center shadow-inner border"></div>

        <!-- व्हाट्सएप शेयर बटन (चालू हालत में) -->
        <button id="shareButton" onclick="shareOnWhatsApp()" class="hidden w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-xl transition duration-200 cursor-pointer shadow-md mb-6 justify-center items-center gap-2 active:scale-95">
            🟢 दोस्तों को WhatsApp पर सावधान करें
        </button>

        <!-- सुरक्षा के नियम -->
        <div class="bg-amber-50 p-4 rounded-xl border border-amber-200">
            <h3 class="font-bold text-amber-800 mb-3 flex items-center gap-1 text-sm">🛡️ सुरक्षा के 3 महामंत्र:</h3>
            <ul class="text-xs text-amber-900 space-y-2 list-decimal list-inside leading-relaxed">
                <li>जो नौकरी के नाम पर <span class="text-red-600 font-bold">₹1 भी मांगे</span> (Registration/Form/Laptop), वह <strong>100% स्कैम</strong> है।</li>
                <li>कोई भी असली bank या company फोन पर आपका <strong>OTP या पासवर्ड</strong> नहीं मांगती।</li>
                <li>बिना मेहनत के, सिर्फ वीडियो लाइक करके या फाइल इंस्टॉल करके रोज़ कमाने वाले दावे <strong>पैसे हड़पने के जाल</strong> हैं।</li>
            </ul>
        </div>
    </div>

    <script>
        let globalMessage = "";

        function checkScam() {
            const text = document.getElementById('scamInput').value.trim();
            const lowerText = text.toLowerCase();
            const resultBox = document.getElementById('resultBox');
            const shareButton = document.getElementById('shareButton');

            if (!text) {
                alert('कृपया जांचने के लिए कोई मैसेज या जॉब ऑफर यहाँ पेस्ट करें!');
                return;
            }

            // रिज़ल्ट और शेयर बटन को रीसेट करें
            resultBox.className = "p-4 rounded-xl mb-4 font-medium text-center shadow-inner border";
            resultBox.classList.remove('hidden');
            shareButton.classList.add('hidden');
            shareButton.classList.remove('flex');

            // फ्रॉड वाले कीवर्ड्स, लिंक्स और फाइल्स
            const scamKeywords = [
                'रजिस्ट्रेशन', 'registration', 'फीस', 'fee', 'charge', 'लैपटॉप', 'laptop', 
                'otp', 'ओटीपी', 'पासवर्ड', 'password', 'लाइक', 'like video', 'लाइक वीडियो',
                'रोजाना कमाएं', 'earning', 'link click', 'लिंक क्लिक', 'टास्क', 'task', 'part time job',
                't.me', 'bit.ly', '.apk', 'whatsapp group', 'क्रिप्टो', 'crypto', 'जीतें', 'इनाम'
            ];

            let isScam = false;
            
            scamKeywords.forEach(keyword => {
                if (lowerText.includes(keyword)) {
                    isScam = true;
                }
            });

            if (isScam) {
                resultBox.innerHTML = "⚠️ <strong>सावधान: यह 100% स्कैम (Fraud) हो सकता है!</strong><br><span class='text-xs font-normal block mt-1'>इस मैसेज में संदिग्ध शब्द, लिंक या फाइल के लक्षण मिले हैं। कृपया सतर्क रहें।</span>";
                resultBox.classList.add('bg-red-50', 'text-red-700', 'border-red-200');
                globalMessage = `🚨 *स्कैम अलर्ट!* 🚨\n\nमुझे एक संदिग्ध फ्रॉड मैसेज मिला है:\n"${text}"\n\nमैंने इसकी जांच *स्कैम रक्षक* ऐप पर की है। आप भी ऐसे किसी फ्रॉड (Telegram Task, OTP, Advance Fee) के चक्कर में न पड़ें। सतर्क रहें! 🛡️`;
                
                // व्हाट्सएप बटन दिखाएं
                shareButton.classList.remove('hidden');
                shareButton.classList.add('flex');
            } else {
                resultBox.innerHTML = "✅ <strong>यह मैसेज सामान्य लग रहा है।</strong><br><span class='text-xs font-normal block mt-1'>हालांकि, फिर भी किसी अनजान लिंक पर अपनी निजी जानकारी साझा न करें।</span>";
                resultBox.classList.add('bg-green-50', 'text-green-700', 'border-green-200');
            }
        }

        // व्हाट्सएप पर शेयर करने का फंक्शन
        function shareOnWhatsApp() {
            if (globalMessage) {
                const encodedMessage = encodeURIComponent(globalMessage);
                window.open(`https://whatsapp.com{encodedMessage}`, '_blank');
            }
        }
    </script>
</body>
</html>