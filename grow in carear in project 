    <script>
        function processIntelligenceScan() {
            const input = document.getElementById('scamInput').value.trim().toLowerCase();
            const resultBox = document.getElementById('resultBox');
            const resultIcon = document.getElementById('resultIcon');
            const resultTitle = document.getElementById('resultTitle');
            const resultDesc = document.getElementById('resultDesc');

            if (!input) {
                alert("कृपया जाँच करने के लिए कोई संदेश या लिंक यहाँ दर्ज करें।");
                return;
            }

            resultBox.classList.remove('hidden');
            const dangerousTriggers = ['like video', 'earn 5000', 'part time job', 'free laptop', 'lottery', 'otp', 'password', 'amzonn'];
            let detectionStatus = false;

            dangerousTriggers.forEach(trigger => {
                if(input.includes(trigger)) { detectionStatus = true; }
            });

            if(detectionStatus) {
                resultBox.className = "rounded-xl p-4 border bg-red-950/20 border-red-900/40 text-red-200 mt-4 flex items-start gap-3";
                resultIcon.innerHTML = "⚠️";
                resultTitle.innerText = "खतरनाक स्कैम (Scam Alert!)";
                resultDesc.innerText = "सावधान! इस मैसेज में फ्रॉड के लक्षण हैं। कोई भी कदम आगे न बढ़ाएं।";
            } else {
                resultBox.className = "rounded-xl p-4 border bg-emerald-950/20 border-emerald-900/40 text-emerald-200 mt-4 flex items-start gap-3";
                resultIcon.innerHTML = "🟢";
                resultTitle.innerText = "सुरक्षित प्रतीत होता है";
                resultDesc.innerText = "यह सामान्य संदेश लग रहा है, फिर भी अपनी गुप्त जानकारी किसी को न दें।";
            }
        }

        // सोलमेट संदेश का जादुई लॉजिक
        function revealSoulmateMessage() {
            const soulmateBox = document.getElementById('soulmateBox');
            const messages = [
                "\"मैं भी ब्रह्मांड के किसी कोने में बैठकर तुम्हारी इस मेहनत को महसूस कर रही हूँ। अपनी कोडिंग पूरी करो, मैं सही समय पर तुम्हारे जीवन में आऊँगी।\"",
                "\"जब तुम पूरी दुनिया को स्कैम से बचा रहे होगे, मैं मुस्कुराकर शिव-शक्ति से तुम्हारी सफलता की प्रार्थना कर रही हूँगी। डटे रहो, अजय!\"",
                "\"तुम्हारा यह मोबाइल वाला संघर्ष ही कल हमारी सबसे खूबसूरत कहानी बनेगा। मन छोटा मत करो, काम पर ध्यान लगाओ।\""
            ];
            const randomIndex = Math.floor(Math.random() * messages.length);
            soulmateBox.innerText = messages[randomIndex];
            soulmateBox.classList.remove('hidden');
        }
    </script>
